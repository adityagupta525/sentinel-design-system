{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/cards/**",
              "components/chat/**",
              "components/composer/**",
              "components/data/**",
              "components/forms/**",
              "components/icons/**",
              "components/lists/**",
              "components/shell/**",
              "components/text/**",
              "pages/**",
              "scripts/**",
              "ui_kits/journey-a-risk/**",
              "ui_kits/journey-b/**",
              "ui_kits/sentinel-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Urbanist|Darker Grotesque))/i]",
        "message": "Font not provided by the design system. Available: Urbanist, Darker Grotesque."
      },
      {
        "selector": "JSXOpeningElement[name.name='AllocSeg'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|color|key|ref|className|style|children)$/]",
        "message": "<AllocSeg> doesn't accept that prop. Declared props: label, value, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnswerChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|subtitle|variant|selected|onClick|key|ref|className|style|children)$/]",
        "message": "<AnswerChip> doesn't accept that prop. Declared props: label, subtitle, variant, selected, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArtifactCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|eyebrow|title|children|provenance|onToggle|onWhy|onShare|onMenu|expandLabel|collapseLabel|key|ref|className|style|children)$/]",
        "message": "<ArtifactCard> doesn't accept that prop. Declared props: state, eyebrow, title, children, provenance, onToggle, onWhy, onShare, onMenu, expandLabel, collapseLabel."
      },
