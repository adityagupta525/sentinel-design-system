{
  "name": "@centricity/sentinel-design-system",
  "version": "2026.9.0",
  "description": "Sentinel — the design system for Centricity WealthTech's chat-led wealth-management assistant for advisors.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./design-system/index.d.ts",
      "default": "./design-system/index.js"
    },
    "./styles.css": "./design-system/styles.css",
    "./tokens/*": "./design-system/tokens/*",
    "./assets/*": "./design-system/assets/*",
    "./adherence": "./design-system/_adherence.oxlintrc.json"
  },
  "files": [
    "design-system"
  ],
  "scripts": {
    "build:artifact": "node tools/build-artifact.mjs",
    "build:barrel": "node tools/build-barrel.mjs",
    "build:bundle": "node tools/build-bundle.mjs",
    "build:catalogue": "node tools/build-catalogue.mjs",
    "build:handoff": "node tools/build-handoff.mjs",
    "build:index": "node tools/build-index.mjs",
    "build:scale": "node tools/extract-scale.mjs",
    "check": "npm run build:barrel && npm run build:bundle && npm run build:index && npm run build:scale && npm run check:tokens && npm run check:integrity && npm run lint:adherence",
    "check:artifact": "node tools/check-artifact.mjs",
    "check:integrity": "node tools/check-integrity.mjs",
    "check:tokens": "node tools/check-tokens.mjs",
    "lint:adherence": "oxlint --config design-system/_adherence.oxlintrc.json design-system",
    "lint:adherence:gate": "oxlint --config design-system/_adherence.oxlintrc.json --max-warnings=59 --silent design-system",
    "lint:adherence:screens": "oxlint --config design-system/_adherence.oxlintrc.json screens",
    "preview": "node tools/preview-server.mjs",
    "report:parallel": "node tools/check-parallel.mjs",
    "shot": "node tools/phone-shot.mjs",
    "build:app": "node tools/build-app.mjs",
    "check:app": "node tools/check-app-boot.mjs",
    "check:ui": "node tools/check-ui.mjs",
    "build:figma-map": "node tools/build-figma-map.mjs",
    "check:figma-parity": "node tools/figma-parity.mjs --self-test"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@babel/standalone": "^7.29.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "esbuild": "^0.28.2",
    "oxlint": "^0.15.0",
    "playwright": "^1.56.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
